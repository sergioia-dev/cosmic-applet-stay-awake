[Desktop Entry]
Name=Stay Awake
Comment=Keep the system awake while the lid is closed.
Type=Application
Icon=com.user.CosmicAppletStayAwake-awake-symbolic
Exec=cosmic-applet-stay-awake %F
Terminal=false
StartupNotify=true
Categories=COSMIC
Keywords=COSMIC
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
MimeType=
